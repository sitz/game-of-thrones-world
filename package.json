{
  "name": "game-of-thrones-world",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Known World — an interactive map of the Game of Thrones TV universe",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "data:fetch": "node scripts/fetch-data.mjs",
    "data:build": "node scripts/build-data.mjs",
    "predev": "node scripts/build-data.mjs --if-missing",
    "prebuild": "node scripts/build-data.mjs"
  },
  "dependencies": {
    "maplibre-gl": "^5.6.0",
    "minisearch": "^7.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "fontnik": "^0.7.7",
    "polylabel": "^2.0.1",
    "typescript": "~5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "zod": "^4.0.0"
  }
}
